{
  "version": 2,
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": {
      "required": true
    },
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": {
      "required": true
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "required": false
    }
  }
}
