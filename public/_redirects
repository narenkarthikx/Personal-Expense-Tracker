# Netlify redirects file

# Redirect all requests to our index.html and let the client router handle it
/*    /index.html   200

# Handle SPA redirects for client-side routing
/auth/*    /index.html   200
/dashboard/*    /index.html   200
/settings/*    /index.html   200

# Handle API routes specially
/api/*  /.netlify/functions/:splat  200
